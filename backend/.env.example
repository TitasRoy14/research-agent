# LLM provider - OpenRouter (dedicated langchain-openrouter integration)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=inclusionai/ling-3.0-flash-vl:free

# Primary search/retrieval provider
SERPER_API_KEY=

# Secondary, independent search provider
SERPAPI_API_KEY=

# Optional tuning
RESEARCH_MAX_SUBQUERIES=3
RESEARCH_MAX_SOURCES_TO_FETCH=6
RESEARCH_MAX_SOURCES_IN_ANSWER=8
